# Environment variables for Gatekeeper
# Update values as needed for your local environment.

# Server
export PORT=8080
export ENVIRONMENT=development


# Database DSN used by Makefile targets
export RESTAURANT_DB_DSN="postgres://adv_web:password@localhost:5432/adv_web?sslmode=disable"

# Backwards compatibility
export DATABASE_URL="$RESTAURANT_DB_DSN"